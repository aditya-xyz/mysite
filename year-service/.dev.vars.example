# Server-side configuration only. Never use VITE_ names for these values.
# Copy to .dev.vars, keep that file local, and never paste credentials into chat.
TWILIO_ACCOUNT_SID=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_VERIFY_SERVICE_SID=""

# Full number including country code, e.g. +1 followed by the 10-digit number.
# This is for the initial invitation setup; it will not be sent to the frontend.
INITIAL_RECIPIENT_NAME=""
INITIAL_RECIPIENT_PHONE_E164=""

# Sending stays off until the provider integration and recipient are checked.
SMS_ENABLED="false"

# Store-scoped private token, starting with orders/read only. Estimates create no order.
PRINTFUL_ENABLED="false"
PRINTFUL_API_TOKEN=""
PRINTFUL_STORE_ID=""
